APP_DISPLAY_TIMEZONE=Europe/Berlin
APP_NAME=Camperwolf
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

CAMPERWOLF_OWNER_EMAIL=

# Public GET throttling is intentionally disabled by default so search engines
# and normal visitors are not restricted. Enable only as an emergency fallback.
CAMPERWOLF_PUBLIC_READ_LIMIT_ENABLED=false
CAMPERWOLF_PUBLIC_READ_PER_MINUTE=180

# Dashboard requests with query parameters are always rate-limited as a safety net
# for crawlers/scrapers that ignore robots.txt. The plain /dashboard stays unlimited.
CAMPERWOLF_FILTERED_BROWSE_PER_MINUTE=60

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Enable temporarily for detailed request debugging.
TELESCOPE_ENABLED=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Application-side mail circuit breakers. Mail is fail-closed unless explicitly enabled.
# Keep debug preview local-only.
CAMPERWOLF_MAIL_ENABLED=false
CAMPERWOLF_MAIL_GLOBAL_PER_MINUTE=20
CAMPERWOLF_MAIL_GLOBAL_PER_HOUR=100
CAMPERWOLF_MAIL_GLOBAL_PER_DAY=50
CAMPERWOLF_MAIL_RECIPIENT_PER_HOUR=10
CAMPERWOLF_MAIL_VERIFICATION_PER_HOUR=5
CAMPERWOLF_MAIL_PASSWORD_RESET_PER_HOUR=5
CAMPERWOLF_MAIL_TYPE_DEFAULT_PER_HOUR=20
CAMPERWOLF_MAIL_DUPLICATE_WINDOW_SECONDS=60
CAMPERWOLF_MAIL_DEBUG_PREVIEW=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
